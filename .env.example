# Copy to .env and fill in your own values. Never commit .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Gemini API key for the invoice parser and reminder drafting.
# gemini-3.8-flash is the model verified working on a free AI Studio key
# (2026-11-07). gemini-2.0-flash is retired, gemini-2.5-flash is closed to
# new keys, gemini-3-flash does not exist, gemini-4-argon needs a paid plan.
AI_API_KEY=
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
